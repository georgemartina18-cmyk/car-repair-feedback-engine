# ---------------------------------------------------------------------------
# Reputation & Feedback Intelligence Engine - environment for n8n
# Copy to .env and fill in. Secrets used by nodes live in n8n CREDENTIALS
# (see docs/02-n8n-setup.md); these variables are non-credential settings.
# ---------------------------------------------------------------------------

# Public HTTPS URL of n8n (used for links in messages and signature checks)
RFE_PUBLIC_URL=https://n8n.example.com
WEBHOOK_URL=https://n8n.example.com/
# How workflows reach each other inside the container (dispatcher wake-up)
RFE_INTERNAL_URL=http://localhost:5678

# WhatsApp Cloud API
RFE_WA_PHONE_NUMBER_ID=
RFE_WA_VERIFY_TOKEN=choose-a-long-random-string
RFE_WA_APP_SECRET=
RFE_DEFAULT_COUNTRY_CODE=44

# Optional overrides for staging / API gateways (leave empty in production)
RFE_WA_API_BASE=
RFE_ANTHROPIC_BASE=

# SMS (Twilio) + email
RFE_TWILIO_FROM=+441234567890
RFE_TWILIO_AUTH_TOKEN=
RFE_EMAIL_FROM="AutoCare Group <feedback@example.com>"
RFE_ADMIN_EMAIL=ops-admin@example.com

# Signs dashboard sessions (any long random string, 32+ chars)
RFE_DASHBOARD_SECRET=change-me-to-a-long-random-string

# n8n runtime switches this system needs
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto
GENERIC_TIMEZONE=Europe/London
TZ=Europe/London
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Postgres (feedback database; n8n can use the same server, separate DB)
POSTGRES_USER=rfe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rfe
