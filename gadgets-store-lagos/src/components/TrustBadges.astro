---
import Icon from './Icon.astro';

const items = [
  { icon: 'shield', title: '100% Genuine', text: 'Original products only' },
  { icon: 'truck', title: 'Nationwide Delivery', text: 'To all 36 states' },
  { icon: 'badge', title: 'Warranty', text: 'On every gadget we sell' },
  { icon: 'store', title: 'Visit Our Store', text: 'Computer Village, Ikeja' },
];
---

<ul class="grid grid-cols-2 gap-2.5 sm:gap-3 lg:grid-cols-4">
  {
    items.map((it) => (
      <li class="flex items-center gap-3 rounded-xl bg-surface p-3 sm:p-4">
        <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-white text-brand shadow-(--shadow-card) sm:size-11">
          <Icon name={it.icon} class="size-5 sm:size-6" />
        </span>
        <span class="min-w-0">
          <span class="block text-[0.8rem] leading-tight font-semibold text-ink sm:text-sm">{it.title}</span>
          <span class="block text-xs leading-snug text-muted">{it.text}</span>
        </span>
      </li>
    ))
  }
</ul>
