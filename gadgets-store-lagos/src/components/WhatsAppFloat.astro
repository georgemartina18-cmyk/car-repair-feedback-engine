---
import Icon from './Icon.astro';
import { whatsappLink } from '../lib/format';

interface Props {
  whatsapp: string;
}
const { whatsapp } = Astro.props;
const href = whatsappLink(whatsapp, 'Hello Gadgets Store in Lagos, I have a question.');
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class="fixed right-4 bottom-4 z-30 flex items-center gap-2 rounded-full bg-wa p-3.5 text-white hover:bg-wa-dark shadow-lift transition-transform hover:scale-105 sm:right-6 sm:bottom-6 sm:py-3 sm:pr-5 sm:pl-3.5"
  aria-label="Chat with us on WhatsApp"
>
  <Icon name="whatsapp" class="size-7" />
  <span class="hidden text-sm font-semibold sm:inline">Chat with us</span>
</a>
