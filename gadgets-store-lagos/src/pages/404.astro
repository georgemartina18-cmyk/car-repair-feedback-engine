---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found" noindex>
  <div class="container-page flex flex-col items-center py-20 text-center">
    <span class="grid size-16 place-items-center rounded-full bg-brand-50 text-brand"><Icon name="search" class="size-8" /></span>
    <h1 class="mt-6 text-3xl font-extrabold sm:text-4xl">We couldn't find that page</h1>
    <p class="mt-3 max-w-md text-muted">The link may be old or the product may have sold out. Try searching, or go back to the homepage.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Go to homepage</a>
      <a href="/contact" class="btn btn-outline">Contact us</a>
    </div>
  </div>
</BaseLayout>
