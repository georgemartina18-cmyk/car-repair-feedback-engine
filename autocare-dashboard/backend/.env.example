# AutoCare Chain Dashboard: backend settings.
# Copy this file to backend/.env and edit it. Every setting is optional;
# the defaults below are used when a line is missing.

# Port the API (and, after `npm start`, the whole app) listens on.
# If you change it, also change the proxy port in frontend/vite.config.js.
PORT=4000

# Default admin account. Only used on FIRST run, when no admin exists yet.
# After that, change the password in Admin > Settings (or `npm run reset-password`).
ADMIN_EMAIL=admin@autocare.local
ADMIN_PASSWORD=Admin@12345

# Secret key used to sign login tokens. Leave it empty and one is generated
# automatically and saved in backend/data/.jwt-secret. If you set it, use a
# long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long an admin stays logged in (e.g. 8h, 12h, 7d).
JWT_EXPIRES_IN=12h

# SQLite database file (relative to the backend folder).
DB_FILE=data/autocare.sqlite

# Time zone for "today"/"this week" on the dashboard and the date in booking refs.
TIMEZONE=Africa/Lagos

# Load sample bookings when the database is empty. Set to false for a clean start.
SEED_SAMPLE_DATA=true

# Only needed if the frontend is hosted on a different address from the backend,
# e.g. https://book.yourdomain.com (comma-separate several).
CORS_ORIGIN=
